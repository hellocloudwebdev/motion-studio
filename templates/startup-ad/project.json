{
  "schemaVersion": "1.0.0",
  "project": {
    "id": "opendoor-startup-ad",
    "name": "Opendoor — Startup Advertisement",
    "objective": "Introduce an hourly house-party space platform and drive social engagement.",
    "frameRate": {
      "numerator": 30,
      "denominator": 1
    },
    "canvas": {
      "width": 1920,
      "height": 1080,
      "pixelAspectRatio": 1,
      "safeAreaPercent": 5
    },
    "totalDurationFrames": 1800,
    "colorSpace": "Rec.709",
    "revision": 1
  },
  "creative": {
    "concept": "A better place for every house party.",
    "audience": "Young adults aged 18–25 in India.",
    "message": "Find a private, ready-to-host space for your next gathering."
  },
  "brand": {
    "colors": {
      "primary": "#F5A623",
      "ink": "#171717",
      "surface": "#FFF8EE"
    },
    "fonts": {
      "display": "Inter",
      "body": "Inter"
    }
  },
  "assets": [],
  "scenes": [
    {
      "id": "scene-001",
      "name": "The problem",
      "durationFrames": 240,
      "intent": "Show the friction of planning a house party.",
      "layers": [
        {
          "id": "s1-bg",
          "kind": "shape",
          "engineHint": "hyperframes"
        },
        {
          "id": "s1-title",
          "kind": "text",
          "engineHint": "hyperframes",
          "typography": {
            "family": "Inter",
            "sizePx": 108,
            "safeArea": true
          }
        }
      ]
    },
    {
      "id": "scene-002",
      "name": "The reveal",
      "durationFrames": 300,
      "intent": "Introduce Opendoor as the solution.",
      "layers": [
        {
          "id": "s2-product",
          "kind": "3d",
          "engineHint": "blender",
          "requiredCapabilities": [
            "3d",
            "lighting"
          ]
        },
        {
          "id": "s2-title",
          "kind": "text",
          "engineHint": "hyperframes",
          "typography": {
            "family": "Inter",
            "sizePx": 92,
            "safeArea": true
          }
        }
      ]
    },
    {
      "id": "scene-003",
      "name": "How it works",
      "durationFrames": 360,
      "intent": "Explain discovery, booking and hosting.",
      "layers": [
        {
          "id": "s3-ui",
          "kind": "image",
          "engineHint": "hyperframes"
        },
        {
          "id": "s3-copy",
          "kind": "text",
          "engineHint": "hyperframes",
          "typography": {
            "family": "Inter",
            "sizePx": 64,
            "safeArea": true
          }
        }
      ]
    },
    {

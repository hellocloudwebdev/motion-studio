  "creative": {
    "concept": "Global renewable capacity additions have climbed every year since 2019 and jumped to a record in 2023. Show the climb with two charts, then land the takeaway: renewables now dominate new power capacity.",
    "audience": "Policy watchers, sustainability teams and general news audiences who follow energy trends.",
    "message": "Renewable additions rose from 176 GW in 2019 to a record 473 GW in 2023, and renewables supplied 86% of all new power capacity in 2023.",
    "visualDirection": "Deep navy editorial data brief with bright green chart marks, large headline typography and restrained caption text.",
    "dataProvenance": {
      "source": "IRENA, Renewable Capacity Statistics 2024 (International Renewable Energy Agency, published March 2024)",
      "sourceUrl": "https://www.irena.org/Publications/2024/Mar/Renewable-capacity-statistics-2024",
      "retrievedAt": "2026-11-13",
      "figuresUsed": {
        "annualCapacityAdditionsGigawatts": { "2019": 176, "2020": 261, "2021": 257, "2022": 295, "2023": 473 },
        "yearEndInstalledRenewableCapacityGigawatts": { "2019": 2537, "2020": 2799, "2021": 3064, "2022": 3372, "2023": 3870 },
        "shareOfAllNewPowerCapacityAddedIn2023Percent": 86
      },
      "note": "Charts show annual renewable capacity additions and year-end installed renewable capacity worldwide as reported by IRENA's Renewable Capacity Statistics 2024."
    }
  },

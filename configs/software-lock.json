{
  "schemaVersion": 2,
  "motionStudioVersion": "0.3.0-alpha.1",
  "runtime": {
    "node": {
      "minimum": "24.0.0",
      "bootstrapMajor": 26
    },
    "packageManager": "npm"
  },
  "npm": {
    "hyperframes": "0.8.86",
    "gsap": "3.14.2",
    "three": "0.181.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "craft": {
    "effectcraft": {
      "supported": ["alpha"],
      "platforms": ["win32", "darwin", "linux"],
      "mcpCommand": "effectcraft-cli mcp",
      "envOverride": "EFFECTCRAFT_CLI",
      "source": "https://github.com/storytold/effectcraft",
      "license": "MIT OR Apache-2.0",
      "status": "alpha"
    },
    "filmcraft": {
      "supported": ["alpha"],
      "platforms": ["win32", "darwin", "linux"],
      "mcpCommand": "filmcraft-cli -- mcp",
      "envOverride": "FILMCRAFT_CLI",
      "source": "https://github.com/storytold/filmcraft",
      "license": "MIT OR Apache-2.0",
      "status": "alpha"
    }
  },
  "externalBinaries": {
    "ffmpeg": {
      "required": true,
      "minimumMajor": 6
    },
    "blender": {
      "required": false
    }
  },
  "notes": [
    "FilmCraft and EffectCraft are open source (MIT / Apache-2.0); install from GitHub releases or getartcraft.com.",
    "Both expose headless MCP servers over stdio via their CLIs; Motion Studio registers them through scripts/craft-mcp-launcher.mjs.",
    "Both tools are alpha: Motion Studio gates every mutation behind explicit producer approval.",
    "No public network listener is enabled; all MCP traffic is local stdio."
  ]
}

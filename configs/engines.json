{
  "version": 4,
  "runtime": {
    "node": ">=24.0.0"
  },
  "engines": {
    "hyperframes": {
      "role": "primary-2d-renderer",
      "package": "hyperframes@0.8.86",
      "capabilities": [
        "2d-motion",
        "kinetic-typography",
        "charts",
        "shapes",
        "web-layout",
        "image-sequence"
      ]
    },
    "blender": {
      "role": "3d",
      "capabilities": [
        "3d",
        "simulation",
        "product-visualization",
        "camera-animation",
        "lighting"
      ]
    },
    "threejs": {
      "role": "webgl-3d",
      "capabilities": [
        "webgl",
        "shader",
        "procedural-3d",
        "interactive-3d"
      ]
    },
    "ffmpeg": {
      "role": "media-pipeline",
      "capabilities": [
        "transcode",
        "trim",
        "scale",
        "audio-mix",
        "image-sequence",
        "media-probe"
      ]
    },
    "effectcraft": {
      "role": "specialist-compositing-and-vfx",
      "mcpCommand": "effectcraft-cli mcp",
      "source": "https://github.com/storytold/effectcraft",
      "capabilities": [
        "compositing",
        "vfx",
        "tracking",
        "roto",
        "advanced-typography",
        "motion-graphics",
        "keyframing",
        "expressions",
        "lottie"
      ]
    },
    "filmcraft": {
      "role": "editorial-assembly",
      "mcpCommand": "filmcraft-cli -- mcp",
      "source": "https://github.com/storytold/filmcraft",
      "capabilities": [
        "timeline-editing",
        "audio-assembly",
        "captions",
        "color",
        "sound-post",
        "export",
        "fcpxml-interchange"
      ]
    },
    "after-effects": {
      "role": "specialist-compositing-and-vfx-licensed",
      "mcpPackage": "@kumoproductions/mcp-aftereffects@0.3.2",
      "capabilities": [
        "compositing",
        "vfx",
        "tracking",
        "roto",
        "advanced-typography",
        "motion-graphics",
        "keyframing"
      ],
      "note": "Licensed Adobe stack, optional: requires a user Creative Cloud subscription; explicit engineHint 'after-effects' selects it over the free EffectCraft default."
    },
    "premiere-pro": {
      "role": "editorial-assembly-licensed",
      "mcpPackage": "premiere-pro-mcp@1.30.0",
      "capabilities": [
        "timeline-editing",
        "audio-assembly",
        "captions",
        "final-cut",
        "export"
      ],
      "note": "Licensed Adobe stack, optional: set MOTION_STUDIO_EDITORIAL_ENGINE=premiere-pro to route assembly through Premiere Pro instead of FilmCraft."
    }
  },
  "executionPolicy": {
    "maxWorkers": 1,
    "draftPreview": true,
    "resumeFromCheckpoint": true,
    "allowArbitraryScript": false,
    "readOnlyCraftOnboarding": true,
    "readOnlyAdobeOnboarding": true
  }
}

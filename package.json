{
  "name": "motion-studio",
  "version": "0.5.0-alpha.1",
  "private": true,
  "description": "Engine-independent AI video production system with HyperFrames rendering and governed Adobe MCP orchestration.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "servers/*"
  ],
  "scripts": {
    "test": "node --test",
    "studio": "node apps/cli/src/index.mjs",
    "mcp": "node servers/mcp-server/src/index.mjs",
    "runtime": "node apps/local-runtime/src/server.mjs",
    "validate:example": "node apps/cli/src/index.mjs validate templates/startup-ad/project.json",
    "route:example": "node apps/cli/src/index.mjs route templates/startup-ad/project.json",
    "compile:example": "node apps/cli/src/index.mjs compile templates/startup-ad/project.json",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/install.mjs",
    "render:smoke": "node scripts/ci-render-smoke.mjs",
    "test:installer-lifecycle": "node scripts/installer-lifecycle-smoke.mjs"
  },
  "license": "MIT",
  "bin": {
    "motion-studio": "./apps/cli/src/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@kumoproductions/mcp-aftereffects": "0.3.2",
    "premiere-pro-mcp": "1.29.0",
    "hyperframes": "0.8.86",
    "gsap": "3.14.2",
    "three": "0.181.2",
    "zod": "3.25.0"
  }
}
